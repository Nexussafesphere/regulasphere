# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# NVIDIA AI (Meta Llama 3)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Groq (Alternative LLM provider)
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Google Cloud (Translation & TTS)
GOOGLE_CLOUD_API_KEY=AIza-your-google-key-here
GOOGLE_TRANSLATE_API=https://translation.googleapis.com/language/translate/v2
GOOGLE_TTS_API=https://texttospeech.googleapis.com/v1/text:synthesize

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Resend (Email)
RESEND_API_KEY=re_your-resend-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Termii (SMS/WhatsApp)
TERMII_API_KEY=tlv_your-termii-key
TERMII_SENDER_ID=RegulaSphere

# Sentry (Error Monitoring)
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/your-project-id

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RegulaSphere
NEXT_PUBLIC_COMPANY_NAME=Nexus SafeSphere Technologies Limited